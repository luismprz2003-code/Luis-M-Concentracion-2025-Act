   ],
   "source": [
    "# Residuals \n",
    "residuals= y_test - y_pred\n",
    "\n",
    "# Plot the residuals\n",
    "plt.scatter(X_test, residuals)\n",
    "plt.axhline(y=0, color='r', linestyle='--')\n",
    "plt.xlabel('X_test')\n",
    "plt.ylabel('Residuals')"
   ]
